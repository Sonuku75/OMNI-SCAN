# ==========================================
# OmniScan Environment Variables Configuration
# ==========================================

# 1. API & Server Configuration
ENVIRONMENT=development
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars

# 2. Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://omniscan:omniscan_password@localhost:5432/omniscan_db
DATABASE_SYNC_URL=postgresql://omniscan:omniscan_password@localhost:5432/omniscan_db

# 3. Object Storage (S3 / MinIO)
STORAGE_PROVIDER=local  # options: local, minio, s3
STORAGE_BUCKET=omniscan-media
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# 4. Redis & Background Task Broker
REDIS_URL=redis://localhost:6379/0

# 5. Media Processing Limits
MAX_UPLOAD_SIZE_IMAGE_MB=25
MAX_UPLOAD_SIZE_AUDIO_MB=50
MAX_UPLOAD_SIZE_VIDEO_MB=150
VIDEO_MAX_DURATION_SECONDS=60
VIDEO_MAX_FRAMES_SAMPLED=100

# 6. Image Forensic & Deep Learning Model Adapter
IMAGE_DETECTOR_ENABLED=true
IMAGE_MAX_PIXELS=50000000
IMAGE_MAX_DIMENSION=8192
IMAGE_MODEL_PATH=  # optional path to pretrained weights (e.g. ./weights/resnet50_deepfake.onnx)
IMAGE_MODEL_NAME=resnet50_deepfake_v1
IMAGE_MODEL_DEVICE=cpu

# 7. Audio Forensic & Voice Clone Model Adapter
AUDIO_DETECTOR_ENABLED=true
AUDIO_MAX_DURATION_SECONDS=180
AUDIO_MAX_SAMPLE_RATE=48000
AUDIO_MODEL_PATH=  # optional path to pretrained weights (e.g. ./weights/aasist_spoof.pth)
AUDIO_MODEL_NAME=aasist_spoof_detector_v1
AUDIO_MODEL_DEVICE=cpu

# 8. Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=OmniScan
