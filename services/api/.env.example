# OmniScan FastAPI Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="OmniScan Forensics API"
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Strict CORS Allowlist (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Secret Key & JWT Configuration (at least 32 characters)
SECRET_KEY=dev-insecure-secret-key-32chars-min-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./omniscan.db
DATABASE_SYNC_URL=sqlite:///./omniscan.db

# Storage Configuration (local, minio, s3)
STORAGE_PROVIDER=local
STORAGE_BUCKET=omniscan-media
LOCAL_STORAGE_DIR=./local_storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Media processing constraints
MAX_UPLOAD_SIZE_IMAGE_MB=25
MAX_UPLOAD_SIZE_AUDIO_MB=50
MAX_UPLOAD_SIZE_VIDEO_MB=150
VIDEO_MAX_DURATION_SECONDS=60
VIDEO_MAX_FRAMES_SAMPLED=100

# Rate Limiting & Security Controls
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=30

# AI/ML Deepfake & Forensic Model Weights (Optional: if omitted, returns detector_not_configured)
# IMAGE_MODEL_PATH=/path/to/weights/resnet50_deepfake.onnx
# AUDIO_MODEL_PATH=/path/to/weights/aasist_spoof.pt
# VIDEO_MODEL_PATH=/path/to/weights/vivit_model.onnx
